# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Email Processing Configuration
# Maximum number of unread emails to fetch and process per run (default: 10)
MAX_EMAILS=10

# Google Cloud Platform Configuration (for cloud deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=gmail-agent
JOB_NAME=gmail-agent-daily-trigger

# Schedule Configuration (when and how often the agent runs via Cloud Scheduler)
# Format: Standard cron expression (minute hour day-of-month month day-of-week)
# Examples:
#   "0 5,17 * * *"   -> Twice daily at 5:00 AM and 5:00 PM (Default)
#   "0 * * * *"      -> Once every hour at the top of the hour
#   "*/30 * * * *"   -> Every 30 minutes
#   "0 8 * * *"      -> Once daily at 8:00 AM
#   "0 9 * * 1-5"    -> Weekdays only (Monday to Friday) at 9:00 AM
SCHEDULE=0 5,17 * * *
TIMEZONE=Asia/Seoul

# Optional: Specify email to receive execution logs
# If not set, will use the authenticated Gmail account
# LOG_EMAIL=your-email@example.com
