# ==============================================================================
# Multi-PC Cloud Migration Environment Configuration (.env.example)
# NOTE: In the multi-PC cloud architecture, local .env files are OPTIONAL!
# If variables or credentials are not defined locally, the agent automatically
# resolves them from Google Cloud Secret Manager and Google Cloud Storage.
# ==============================================================================

# Google Cloud Project Configuration
GCP_PROJECT_ID=gen-lang-client-0480639565
GCP_REGION=us-central1
SERVICE_NAME=gmail-agent
JOB_NAME=gmail-agent-daily-trigger

# Google Cloud Secret Manager Secret Names
# - gemini-api-key: Google Gemini AI API key
# - gmail-agent-token: Serialized OAuth token JSON for Gmail API
# - gmail-oauth-credentials: OAuth client secret credentials JSON
GMAIL_TOKEN_SECRET_NAME=gmail-agent-token
GMAIL_CREDENTIALS_SECRET_NAME=gmail-oauth-credentials
GEMINI_API_KEY=

# Google Cloud Storage (GCS) State & Audit Logging
# Canonical bucket format: gs://<GCP_PROJECT_ID>-gmail-agent-data/
GCS_BUCKET_NAME=gen-lang-client-0480639565-gmail-agent-data
GCS_BLOB_PATH=gmail-agent/state.json
GCS_LOG_BLOB_PATH=gmail-agent/run_log.json

# Email Processing Configuration
MAX_EMAILS=20

# Schedule Configuration (when and how often the agent runs via Cloud Scheduler)
SCHEDULE=0 5,17 * * *
TIMEZONE=Asia/Seoul

# Optional Continuous Loop Interval (in minutes for local execution)
# RUN_INTERVAL_MINUTES=30
